# Variáveis de ambiente do Soulie API.
# Copie para .env e preencha. O .env é ignorado pelo Git — nunca comite valor real.
#
# Marcações:
#   [obrigatória]  a aplicação não sobe sem ela
#   [fase N]       só passa a ser usada a partir daquela fase do plan.md

# ---------------------------------------------------------------------------
# Banco de dados — PostgreSQL  [obrigatória]
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soulie
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Autenticação  [obrigatória]
# ---------------------------------------------------------------------------
# Segredo do JWT (HMAC256). Mínimo de 32 caracteres — a aplicação RECUSA subir
# com valor vazio ou mais curto que isso, porque uma chave curta é
# força-brutável offline a partir de um único token.
# Gere o seu com:
#   openssl rand -base64 48
# Não deixe esta linha em branco: substitua o valor de exemplo abaixo.
SECRET_JWT=COLE-AQUI-UM-VALOR-DE-48-BYTES-GERADO-POR-OPENSSL

# ---------------------------------------------------------------------------
# CORS  [fase 1]
# ---------------------------------------------------------------------------
# Lista separada por vírgula. Em produção, só as origens reais do app/web.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Perfil do Spring
# ---------------------------------------------------------------------------
# dev | prod   (o perfil test é usado automaticamente pelos testes)
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Storage de imagem — bucket do Railway, compatível com S3  [obrigatória em prod]
# ---------------------------------------------------------------------------
# No perfil dev as fotos vão para data/soulie-images e estas variáveis podem
# ficar em branco. Em SPRING_PROFILES_ACTIVE=prod elas são obrigatórias.
# Os valores reais estão no Railway, em: bucket > aba Credentials.
# Não cole aqui os valores de produção: este arquivo é versionado, e endpoint e
# nome do bucket são exatamente o alvo que falta a quem conseguir uma chave.
S3_ENDPOINT=https://SEU-ENDPOINT-S3
S3_REGION=auto
S3_BUCKET=SEU-BUCKET
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Deixe VAZIO se o bucket for privado (é o caso por padrão). Com isso vazio, a
# IA lê a imagem por URL assinada temporária, e nenhuma foto fica acessível
# publicamente. Preencha só se o bucket servir leitura pública de propósito.
S3_PUBLIC_BASE_URL=
# Validade da URL assinada entregue à IA. Curta: é tempo de uma chamada.
S3_PRESIGNED_TTL=PT15M

# ---------------------------------------------------------------------------
# RabbitMQ — fila de validação por IA  [obrigatória em prod]
# ---------------------------------------------------------------------------
# No perfil dev a validação roda no mesmo processo, sem broker. Em produção,
# sem o broker, POST /v1/missions/{id}/validate responde 503 em vez de aceitar
# uma evidência que nunca seria analisada.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ---------------------------------------------------------------------------
# API de validação de imagem por IA (do parceiro de equipe)  [fase 4]
# ---------------------------------------------------------------------------
# Endpoint onde a imagem é enviada para validação. O contrato está em
# docs/04-contrato-ia.md. Implementação: repo soulie-validation-pictures,
# POST /v1/analisar.
# ATENÇÃO: este endereço vem SÓ daqui. Se viesse de entrada do usuário, o worker
# viraria um proxy de SSRF contra a rede interna.
#
# Local (perfil dev já usa estes padrões se as variáveis ficarem vazias):
#   AI_VALIDATION_URL=http://localhost:5000/v1/analisar
#   AI_DELIVERY_MODE=BYTES
# Sem o Python no ar, esvazie a URL e ligue o stub:
#   AI_VALIDATION_URL=
#   SOULIE_AI_STUB=true
AI_VALIDATION_URL=http://localhost:5000/v1/analisar
AI_VALIDATION_API_KEY=

# PRESIGNED_URL: manda um link temporário (padrão em prod; bucket privado).
# BYTES: manda a imagem em base64 — use no dev com storage local.
AI_DELIVERY_MODE=BYTES

# Análise de imagem é lenta, mas o limite precisa existir: sem ele um worker
# fica preso para sempre numa IA que não responde.
AI_READ_TIMEOUT=PT30S

# Webhook de retorno — só ligue se a IA do parceiro responder DEPOIS, em vez de
# na própria chamada. Um endpoint público a mais que ninguém usa é só superfície
# de ataque. Se ligar, o segredo é obrigatório: esse endpoint concede XP.
# Gere com: openssl rand -hex 32
AI_WEBHOOK_ENABLED=false
AI_WEBHOOK_SECRET=
AI_CALLBACK_URL=https://SEU-DOMINIO/webhooks/validations

# ASYNC = responde 202 e credita XP depois da IA aprovar (padrão)
# SYNC  = credita na própria requisição, para o app migrar sem quebrar de uma vez
VALIDATION_MODE=ASYNC

# ---------------------------------------------------------------------------
# Rate limit  [opcional]
# ---------------------------------------------------------------------------
# O rate limit funciona SEM Redis: nesse modo os contadores ficam em memória e
# o limite vale por instância. Continua barrando o abuso óbvio, mas com N
# instâncias o teto real é N vezes maior.
RATE_LIMIT_ENABLED=true

# Ligue quando houver um Redis provisionado — aí o limite passa a ser
# compartilhado entre todas as instâncias. Com false, o Redis nem é contatado.
RATE_LIMIT_DISTRIBUTED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare — WAF / proxy reverso na frente da API  [fase 6]
# ---------------------------------------------------------------------------
# Ligue SÓ quando a API estiver de fato atrás do Cloudflare.
#
# Com isto ligado, a aplicação passa a aceitar CF-Connecting-IP — mas APENAS
# quando a conexão vem das faixas confiáveis. Aceitar o cabeçalho de qualquer
# origem é bypass direto: bastaria mandar um IP diferente a cada requisição
# para nunca bater no limite. Com isto DESLIGADO e a API atrás de um proxy, o
# oposto acontece: todo mundo compartilha o IP do proxy e o limite por IP
# estrangula todos juntos.
CLOUDFLARE_ENABLED=false

# Vazio usa as faixas publicadas pelo Cloudflare, embutidas na aplicação.
# Elas mudam de tempos em tempos: https://www.cloudflare.com/ips/
CLOUDFLARE_TRUSTED_IPS=
# NAO ha Cloudflare Access aqui. Este arquivo declarava
# CLOUDFLARE_ACCESS_ENABLED/TEAM_DOMAIN/AUDIENCE prometendo "proteger Swagger e
# rotas administrativas em produção", e nenhuma linha do projeto lia essas
# variaveis. Em producao o Swagger e desligado pelo perfil prod
# (springdoc.api-docs.enabled: false), e e assim que ele fica protegido.

# ---------------------------------------------------------------------------
# Chat da Alma — LLM OpenAI-compatível (Groq por padrão)  [opcional]
# ---------------------------------------------------------------------------
# Sem URL ou sem chave, POST /v1/chat/soulie-ia responde o FAQ por palavra-chave.
# Trocar para Gemini: mesma forma de JSON, só mude URL e modelo.
#   SOULIE_CHAT_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   SOULIE_CHAT_LLM_MODEL=gemini-2.5-flash
SOULIE_CHAT_LLM_URL=https://api.groq.com/openai/v1/chat/completions
SOULIE_CHAT_LLM_API_KEY=
SOULIE_CHAT_LLM_MODEL=qwen/qwen3.8-27b
SOULIE_CHAT_LLM_READ_TIMEOUT=PT20S
